# --- Database ---
# Valori coerenti con docker-compose.yml alla radice del repo (postgres locale
# sul portatile: `docker compose up -d`).
DATABASE_URL="postgresql://piazzetta:piazzetta@localhost:5432/lapiazzetta?schema=public"
PORT=3000
NODE_ENV=development   # in "production" gli header dev di auth sono disattivati

# --- Rete locale (portatile come server) ---
# Il portatile espone l'API sulla LAN del locale (stesso Wi-Fi/router) così i
# frontend su tablet/telefono/altri PC possono raggiungerla. Trovare l'IP del
# portatile con `ipconfig getifaddr en0` (Mac) o `hostname -I` (Linux) e usarlo
# come VITE_API_URL nei frontend, es. http://192.168.1.50:3000/api/v1
CORS_ORIGIN=*

# --- Auth (JWT HS256) ---
JWT_SECRET=            # OBBLIGATORIO in produzione: stringa lunga e casuale
JWT_ACCESS_TTL_SEC=900       # access token: 15 min
JWT_REFRESH_TTL_SEC=2592000  # refresh token: 30 giorni

# Rotazione zero-downtime del segreto: imposta JWT_SECRET_PREVIOUS con il
# vecchio segreto durante la rotazione. I token firmati col vecchio segreto
# restano validi fino alla scadenza; i nuovi token sono firmati col corrente.
# JWT_SECRET_KID=current          # etichetta del segreto corrente (nell'header JWT)
# JWT_SECRET_PREVIOUS=            # vecchio segreto (per la rotazione)
# JWT_SECRET_PREVIOUS_KID=previous

# --- Coda job / cache / rate-limit / real-time (opzionale) ---
# Se impostata e i pacchetti bullmq/ioredis/ws sono installati, la coda usa
# Redis, la cache entitlement e il rate-limit sono condivisi tra istanze;
# altrimenti tutto resta in-memory (dev/test su singolo portatile).
REDIS_URL=

# --- Rate limiting ---
# Limite richieste AI per minuto per utente (default 60).
AI_RATE_LIMIT_PER_MIN=60

# --- Logging ---
# Livello log: debug | info | warn | error (default: info in prod, debug in dev)
LOG_LEVEL=info

# --- Real-time WebSocket (KDS push) ---
# Il server WebSocket si attacca a /ws sullo stesso server HTTP dell'API.
# Richiede il pacchetto `ws` installato; in assenza le webapp KDS continuano
# col polling a 5s (degradazione graceful).

# --- AI (OpenAI + Anthropic) ---
# Le chiavi NON vanno committate. In produzione leggerle da un vault.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modelli (override opzionale)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Base URL (override per proxy/gateway o test)
# OPENAI_BASE_URL=https://api.openai.com/v1
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Routing per task: openai | anthropic (se assente si usa il default del codice)
# AI_ROUTE_UPSELL=openai
# AI_ROUTE_DEMAND_FORECAST=anthropic
# AI_ROUTE_MARKETING_COPY=anthropic
# AI_ROUTE_SHIFT_SUGGESTION=anthropic
# AI_ROUTE_WEBCAM_CLASSIFY=openai

# Affidabilità e costi
AI_MAX_RETRIES=2
AI_TIMEOUT_MS=20000
AI_MONTHLY_BUDGET_CENTS=0   # 0 = illimitato
AI_CACHE_TTL_MS=600000      # cache task deterministici (10 min)
AI_FORECAST_SAFETY_DAYS=3   # copertura di sicurezza nel riordino predittivo
