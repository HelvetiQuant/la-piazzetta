{
  "name": "@la-piazzetta/api",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "description": "API La Piazzetta — Express + Prisma. Include AiService (OpenAI + Anthropic).",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed:menu": "tsx prisma/seed-menu.ts",
    "db:import:menu:sql": "psql \"$DATABASE_URL\" -f prisma/seed/menu_prices.sql",
    "gen:menu:sql": "node --experimental-strip-types prisma/gen-menu-sql.mts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ../../tests/register-ts-resolve.mjs ../../tests/ai.test.mts && node --experimental-strip-types --import ../../tests/register-ts-resolve.mjs ../../tests/auth-queue-entitlement.test.mts",
    "test:logic": "node ../../tests/verify.mjs && node ../../tests/verify-inventory.mjs && node ../../tests/verify-purchase.mjs",
    "ci": "npm run prisma:generate && npm run typecheck && npm run build && npm run test:logic && npm test"
  },
  "dependencies": {
    "@prisma/client": "^5.19.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "zod": "^3.23.8",
    "ws": "^8.18.0"
  },
  "optionalDependencies": {
    "bullmq": "^5.13.0",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.5.0",
    "@types/ws": "^8.5.12",
    "prisma": "^5.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed-menu.ts"
  }
}
